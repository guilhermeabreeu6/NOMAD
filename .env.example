# Nenhuma variavel e segredo. Usadas por scripts/build.mjs (build estatico).
# Prefixo de URL quando o site fica em subpasta (ex.: /loja/). Padrao: /
BASE_PATH=/
# URL publica completa (opcional): habilita canonical e og:* absolutos. Ex.: https://www.exemplo.com.br
SITE_URL=
# true => meta robots noindex + X-Robots-Tag + robots.txt Disallow (build estatico). Padrao: false.
# O build da Vercel e SEMPRE noindex, independentemente desta variavel.
NOINDEX=false
