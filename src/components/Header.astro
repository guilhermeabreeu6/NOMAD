---
import { withBase } from '../data/url';
import Logo from './Logo.astro';

interface Props {
  /** "promo": landing sem carrinho (logo volta para a loja e "Ver catálogo" no lugar do carrinho). */
  variant?: 'store' | 'promo';
}
const { variant = 'store' } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    {
      variant === 'promo' ? (
        <>
          <a href={withBase('')} class="logo-link" aria-label="NOMAD puffs, voltar para a loja">
            <Logo />
          </a>
          <a class="btn btn--text" href={`${withBase('')}#catalogo`}>
            Ver catálogo
          </a>
        </>
      ) : (
        <>
          <a href="#topo" class="logo-link" aria-label="NOMAD puffs, início">
            <Logo />
          </a>
          <button type="button" class="cart-btn" data-open-cart aria-label="Abrir carrinho, 0 itens" aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z" />
              <path d="M9 8V6a3 3 0 0 1 6 0v2" />
            </svg>
            <span class="badge" data-badge hidden aria-hidden="true">0</span>
          </button>
        </>
      )
    }
  </div>
</header>
