---
// Banner da promoção de frete na home (design 5). Um único link para /outubro/.
// Visível só com html[data-promo='ativa'] (CSS em app.css); o estado é resolvido antes da pintura.
import { FRETE_OUTUBRO } from '../data/promos';
import { withBase } from '../data/url';
---

<div class="wrap promo-banner-wrap" data-promo-only="ativa">
  <a class="promo-banner" href={withBase(FRETE_OUTUBRO.pagePath)} data-promo-banner>
    <svg class="promo-banner__icon" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 22c3-6 8-2 11-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 3"></path>
      <path d="M20 13.5c-2.2-2.4-3.5-4.2-3.5-6a3.5 3.5 0 0 1 7 0c0 1.8-1.3 3.6-3.5 6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
      <circle cx="20" cy="7.5" r="1.2" fill="currentColor"></circle>
    </svg>
    <span class="promo-banner__body">
      <span class="promo-banner__eyebrow">Outubro · Palmas - TO</span>
      <strong class="promo-banner__title">Frete grátis <span class="serif">o mês todo</span></strong>
      <span class="promo-banner__text">Na maior parte da cidade, até 31/10. Confira as regiões.</span>
    </span>
    <span class="promo-banner__cta">Ver regiões<span class="promo-banner__arrow" aria-hidden="true"> &rarr;</span></span>
  </a>
</div>
