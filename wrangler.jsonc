// Worker "nomad" (Cloudflare Workers Builds) — produção em nomadpuffs.com.br.
// Só serve arquivos estáticos do build `npm run build:cloudflare` (sem código de Worker).
// Sem este arquivo a Cloudflare autoconfigura um `astro build` genérico (sem _headers nem robots.txt).
{
  "name": "nomad",
  "compatibility_date": "2026-10-01",
  // Domínios ficam aqui: cada deploy substitui a configuração feita no painel.
  "routes": [
    { "pattern": "nomadpuffs.com.br", "custom_domain": true },
    { "pattern": "www.nomadpuffs.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
